<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:title="Pengaturan"
        app:titleTextColor="?attr/colorOnPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swPeekLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intip pesan hanya saat layar terkunci" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFullScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Selalu pakai tampilan layar penuh" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSilence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Bisukan dering sistem saat FotoContact tampil" />

            <TextView
                android:id="@+id/peekLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekPeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Kata kunci panggilan video (pisahkan dengan koma)"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etVideoKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kata kunci notifikasi yang diabaikan"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMissedKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Membuka tampilan intip pesan TIDAK menandai pesan WhatsApp sebagai sudah dibaca, selama Anda tidak membuka aplikasi WhatsApp."
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
